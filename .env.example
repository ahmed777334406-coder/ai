# Copy to .env. Never commit the real .env file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./smartfind.db
POSTGRES_PASSWORD=smartfind_local_only

# Google Gemini. The backend works without this key using clearly labelled fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

JWT_SECRET_KEY=replace-with-a-long-random-secret-before-sharing
ACCESS_TOKEN_EXPIRE_MINUTES=720
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

TEXT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
IMAGE_EMBEDDING_MODEL=ViT-B-32
AI_DEVICE=auto
MODEL_CACHE_DIR=./.model-cache

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=
ENABLE_LOCAL_MODELS=false
INSTALL_AI_DEPS=false

# Hybrid matching weights (relative weights are normalized over available signals)
MATCH_WEIGHT_TEXT=0.32
MATCH_WEIGHT_IMAGE=0.28
MATCH_WEIGHT_CATEGORY=0.12
MATCH_WEIGHT_COLOR=0.08
MATCH_WEIGHT_TIME=0.10
MATCH_WEIGHT_LOCATION=0.10
TIME_DECAY_DAYS=14
